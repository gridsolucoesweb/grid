{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing-pages/grid-lp-func-dig-para-prestadora-de-servico/lp-principal-v1"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/landing-pages/grid-lp-func-dig-para-prestadora-de-servico/politica-de-privacidade"
    },
    {
      "source": "/termos-de-uso",
      "destination": "/landing-pages/grid-lp-func-dig-para-prestadora-de-servico/termos-de-uso"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/shared/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": true
}
